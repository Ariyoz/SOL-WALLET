# Solana network configuration
# Use "devnet" for development, "mainnet-beta" for production
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# API server configuration
API_HOST=127.0.0.1
API_PORT=3000

# Optional: CoinGecko API key for SOL/USD price (leave blank for public API)
COINGECKO_API_KEY=

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:./wallet.db
# DATABASE_URL=postgresql://user:password@localhost/solana_wallet

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# ── USDC Wallet Fee ────────────────────────────────────────────────────────────
# Fee charged per USDC send, in USDC micro-units (6 decimals).
# 10000 = 0.01 USDC  |  30000 = 0.03 USDC  |  0 = no fee
USDC_FEE_UNITS=10000

# Wallet address that collects the USDC fee (your wallet/treasury address)
USDC_FEE_WALLET=

# ── Fee Payer for ATA Creation ─────────────────────────────────────────────────
# Optional: base58-encoded keypair (64 bytes) for the server-side fee payer.
# When set, this keypair pays the ~0.002 SOL rent to create recipient USDC
# token accounts so users don't need extra SOL.
# Leave blank to require the sender to have enough SOL themselves.
FEE_PAYER_KEYPAIR_BASE58=
